# CloudOps Monitor configuration. Copy to backend/.env (development) or pass as environment
# variables (container). Placeholder values only: never commit a real .env file.

# --- Authentication ---------------------------------------------------------------------------
# "token" (default) protects every operator action; "disabled" is for your own machine only.
CLOUDOPS_AUTH_MODE=token
# At least 32 characters. Generate one with: cloudops generate-token
CLOUDOPS_OPERATOR_TOKEN=replace-with-output-of-cloudops-generate-token
# Hours a browser sign-in lasts (1-168).
CLOUDOPS_SESSION_HOURS=12
# Host names this server answers for (comma-separated). Add your public name if you have one.
CLOUDOPS_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# --- Monitoring targets (docs/SECURITY.md section 3) ------------------------------------------
# "allowlist": only host:port entries below may be monitored (they may be private addresses).
# "public": additionally, any host that resolves only to public addresses.
CLOUDOPS_TARGET_POLICY=allowlist
CLOUDOPS_ALLOWED_TARGETS=localhost:8310
CLOUDOPS_WORKER_ENABLED=true
CLOUDOPS_MONITOR_MAX_CONCURRENCY=10

# --- Deployment records from GitHub Actions ---------------------------------------------------
# Optional. Public repositories work without a token (60 requests/hour). For private repositories
# use a fine-grained token limited to the selected repositories with "Actions: read" and
# "Metadata: read" only.
CLOUDOPS_GITHUB_TOKEN=
CLOUDOPS_GITHUB_SYNC_SECONDS=300

# --- Storage and retention ----------------------------------------------------------------------
CLOUDOPS_DATA_DIR=data
CLOUDOPS_AUTO_MIGRATE=true
CLOUDOPS_CHECK_RETENTION_DAYS=30
CLOUDOPS_EVENT_RETENTION_DAYS=90
CLOUDOPS_LOG_RETENTION_DAYS=7
CLOUDOPS_LOG_MAX_ROWS=200000
# Log entries accepted per application per minute.
CLOUDOPS_INGEST_MAX_ENTRIES_PER_MINUTE=6000

# --- Operations -------------------------------------------------------------------------------
CLOUDOPS_LOG_LEVEL=INFO
# "json" (one object per line) or "text" (readable, for development).
CLOUDOPS_LOG_FORMAT=json
CLOUDOPS_API_DOCS=true
